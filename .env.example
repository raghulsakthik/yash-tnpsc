# Local development defaults. Never commit .env.local.
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova
APP_URL=http://localhost:3001
CRON_SECRET=replace-with-a-long-random-secret
DB_POOL_MAX=5
OBJECT_STORAGE_MODE=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CONTENT_WORKER_POLL_MS=2000

# TextBee (real Android phone as the SMS gateway, see src/lib/textbee.mjs)
# -- used by /api/cron/study-reminder.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
STUDY_REMINDER_PHONE=

NOVA_LEARNER_ID=00000000-0000-0000-0000-000000000001
NOVA_LEARNER_NAME=Yashika
NOVA_LANGUAGE=en
