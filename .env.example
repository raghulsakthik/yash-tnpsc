# Copy to .env.local and adjust. Never commit .env.local.
DATABASE_URL=postgresql://yash:yash@localhost:5432/yash

# The single learner this instance serves. Seeded by scripts/seed.mjs.
APP_LEARNER_ID=00000000-0000-0000-0000-000000000001
APP_LEARNER_NAME=Yashika

# Which language paper she is sitting: ta or en. Decides which content is served.
APP_LANGUAGE=en

# Web Push (browser pop-up notifications). Generate your own with
# `npx web-push generate-vapid-keys` -- these are per-deployment, never
# share the private key or commit real values.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
