# Copy to .env.local and adjust. Never commit .env.local.
DATABASE_URL=postgresql://yash:yash@localhost:5432/yash

# The single learner this instance serves. Seeded by scripts/seed.mjs.
APP_LEARNER_ID=00000000-0000-0000-0000-000000000001
APP_LEARNER_NAME=Yashika

# Which language paper she is sitting: ta or en. Decides which content is served.
APP_LANGUAGE=en

# Web Push (browser pop-up notifications). Generate your own with
# `npx web-push generate-vapid-keys` -- these are per-deployment, never
# share the private key or commit real values.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (Gmail SMTP via an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AI tutor hints (src/lib/ai/provider.mjs). Get a key at
# https://aistudio.google.com/apikey -- optional, the app works without it.
GEMINI_API_KEY=

# WhatsApp (Meta Cloud API, src/lib/whatsapp.mjs). Get these from
# developers.facebook.com -- WhatsApp > API Setup. The access token from
# that page is temporary (~24h); generate a permanent one via a System
# User in Meta Business Settings before relying on this long-term.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Android push (src/lib/fcm.mjs). Create a free Firebase project at
# console.firebase.google.com, then Project Settings > Service Accounts >
# Generate New Private Key -- paste the ENTIRE downloaded JSON file as one
# line here. Optional; achievement/activity notifications just skip
# Android devices until this is set.
FIREBASE_SERVICE_ACCOUNT_JSON=
