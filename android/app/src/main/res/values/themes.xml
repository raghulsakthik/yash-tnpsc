<resources>
    <!-- Shown for the cold-start frame before Compose has anything to draw,
         same black and the launcher icon's own glass mark, so there is no
         blank-white flash before the branded loading screen takes over. -->
    <style name="Theme.Yash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yash</item>
    </style>

    <style name="Theme.Yash" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
