[Unit]
Description=TNPSC Retrieval Engine local API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yash/tnpsc/engines/retrieval
EnvironmentFile=-/home/yash/tnpsc/engines/retrieval/.env
ExecStart=/home/yash/tnpsc/engines/retrieval/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/yash/tnpsc/engines/retrieval/data /home/yash/tnpsc/engines/retrieval/logs

[Install]
WantedBy=default.target
