{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:loop": "node tests/loop.smoke.mjs",
    "test:domain": "node tests/domain-model.smoke.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "setup": "npm run db:migrate && npm run validate:content && npm run db:seed"
  },
  "dependencies": {
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  }
}
